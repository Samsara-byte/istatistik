# Vite ortam değişkenleri — .env dosyasına kopyalayın
# Next.js'te NEXT_PUBLIC_API_URL idi, Vite'da VITE_ prefix zorunlu

# Geliştirme ortamı (vite.config.ts içindeki proxy sayesinde bu genellikle boş bırakılır)
VITE_API_URL=http://localhost:8000

# Üretim ortamı — backend adresinizi yazın
# VITE_API_URL=https://api.burdur-tarim.gov.tr
